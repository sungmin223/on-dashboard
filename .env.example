# ===== 영업ON본부 대시보드 Stage 4 — 환경변수 샘플 =====
# 이 파일을 복사해 .env 로 만들고 값을 채우세요:  cp .env.example .env
# ⚠ .env 는 .gitignore 에 포함되어 커밋되지 않습니다. API 키를 절대 클라이언트/깃에 노출하지 마세요.

# Anthropic(Claude) API 키 — 서버에서만 사용
ANTHROPIC_API_KEY=

# 사용할 모델 (기본: Sonnet 4.6). 변경 가능: claude-opus-4-8 / claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# 백엔드 프록시 포트
PORT=3001

# /api 접근 인증 — 비밀번호 원문의 SHA-256 해시(소문자 hex).
# 기본값은 프론트 게이트(GATE_HASH)와 동일하게 내장되어 있어 비워두면 같은 비밀번호로 보호됩니다.
# 별도 API 비밀번호를 쓰려면 그 해시를 지정하고, 인증을 끄려면 빈 문자열로 두세요(공개 배포 비권장).
ACCESS_HASH=
